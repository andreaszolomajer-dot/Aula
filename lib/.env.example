# ====== VIDEO (obligatoriu) ======
# De la https://cloud.livekit.io → Settings → Keys
LIVEKIT_API_KEY=cheia_ta_aici
LIVEKIT_API_SECRET=secretul_tau_aici
NEXT_PUBLIC_LIVEKIT_URL=wss://proiectul-tau.livekit.cloud

# ====== PROGRAMARE + EMAIL (opțional) ======
# Baza de date pentru ședințele salvate — https://supabase.com (gratuit)
# Din Project Settings → API: URL-ul proiectului și cheia "service_role"
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Trimiterea invitațiilor pe email — https://resend.com (gratuit, 3.000/lună)
RESEND_API_KEY=
# Adresa expeditorului. Pentru testare poți folosi "onboarding@resend.dev"
# (trimite doar către adresa contului tău). Pentru trimitere reală, verifică
# un domeniu al tău în Resend și pune-l aici, ex: "Aula <ceva@domeniultau.ro>"
EMAIL_FROM=Aula <onboarding@resend.dev>

# URL-ul public al aplicației (pentru linkurile din invitații)
# Local: http://localhost:3000 · După deploy: https://aula-xxx.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ====== TRADUCERE (opțional) ======
# Fără această cheie, traducerea folosește MyMemory (gratuit, fără cont).
# Pentru calitate mai bună: cheie gratuită DeepL (500.000 caractere/lună)
# de la https://www.deepl.com/pro-api
DEEPL_API_KEY=

# ====== CONTURI (autentificare) ======
# Chei PUBLICE Supabase (Project Settings → API). Sigure de expus în browser.
NEXT_PUBLIC_SUPABASE_URL=https://proiectul-tau.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cheia_anon_publica

# Emailuri de administrator (separate prin virgulă) — pot vedea leadurile la /leads
ADMIN_EMAILS=tu@exemplu.ro

# ====== REMINDERE (opțional) ======
# O parolă secretă pe care o pui și în linkul cron-ului extern, ca doar el să declanșeze trimiterea.
# Inventează un text lung, aleatoriu, ex: aula-remind-9f3k2x8w
CRON_SECRET=
